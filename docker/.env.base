###
# General settings
###

# Accept the NVIDIA Omniverse EULA by default
ACCEPT_EULA=Y
# NVIDIA Isaac Sim base image
ISAACSIM_BASE_IMAGE=nvcr.io/nvidia/isaac-sim
# NVIDIA Isaac Sim version to use (e.g. 6.0.1)
ISAACSIM_VERSION=6.0.1
# Derived from the default path in the NVIDIA provided Isaac Sim container
DOCKER_ISAACSIM_ROOT_PATH=/isaac-sim
# The Isaac Lab path in the container
DOCKER_ISAACLAB_PATH=/workspace/isaaclab
# Docker runtime user directory
DOCKER_USER_HOME=/root
# Docker image and container name suffix (default "", set by the container_interface.py script)
# Example: "-custom"
DOCKER_NAME_SUFFIX="-custom"
# Name of the Docker Compose project to isolate this environment
COMPOSE_PROJECT_NAME=isaac-lab-custom
# Local IP address of the host machine for WebRTC streaming (Isaac Sim)
ISAACSIM_HOST=127.0.0.1
